# Media renders / videos
*.mp4
*.mov
*.avi
# ...except short clips embedded in slide decks (deployed with figs/)
!slides/*/figs/*.mp4
tools/manim/**/media/
tools/manim/**/__pycache__/

# Mechanical extraction output from the legacy PowerPoints: text dumps,
# equation crops, diagram renders, Mathpix OCR results. Fully regeneratable
# via tools/ (see tools/README.md), no student-facing value, and 68% of the
# repo by file count - untracked 2026-08-27 ahead of making the repo public.
# Still written and read locally; only the remote copy goes away.
slides/*/raw/

# Retired topic material (Topic 8's dissolved deck and its media). Project
# history, kept on disk and described in TOPIC_PLAN.md / HANDOFF.md, but not
# something a public course repo needs to carry.
# (Pattern is docs/archive/* rather than docs/archive/ so the negation below
# still works - git does not descend into a wholly excluded directory.)
docs/archive/*
# The one exception: HANDOFF.md, README.md and TOPIC_PLAN.md all link to the
# Marp-era handoff, so keep that single file tracked to avoid dead links.
!docs/archive/HANDOFF-marp.md

# Quarto's in-place render output (tools/verify_deck.py renders deck.qmd
# in its own topic folder, then cleans up - this is a safety net in case
# that cleanup doesn't run promptly, e.g. a lingering OS-level file lock
# from Drive sync/Search indexing/antivirus on the just-written directory)
slides/*/deck.html
slides/*/deck_files/
slides/*/deck.quarto_ipynb

# Same in-place render output, but for the standalone Quarto feature-demo
# reference deck (not a course topic, so it isn't under slides/)
docs/quarto-feature-demo/quarto_demo.html
docs/quarto-feature-demo/quarto_demo_files/
docs/quarto-feature-demo/quarto_demo.quarto_ipynb
docs/quarto-feature-demo/rstack_*.png

# Same again for the authoring feature-tour deck in slides/demos/ (named
# feature-tour.qmd, not deck.qmd, so CI's `find slides -name deck.qmd`
# render loop skips it - see the deck's own last slide)
slides/demos/feature-tour.html
slides/demos/feature-tour_files/
slides/demos/feature-tour.quarto_ipynb

# Decktape/quarto PDF export of a deck, produced locally by verify_deck.py or
# by hand. Render output, same as deck.html - CI builds its own copy.
slides/*/deck*.pdf

# LaTeX build artifacts (the compiled syllabus PDF itself IS tracked)
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
syllabus/*.log
syllabus/*.out

# Quarto's stray notebook intermediates from the demos deck
slides/demos/feature-tour.quarto_ipynb*

# Working material that lives in the repo but is not part of the course build.
# Kept on disk (and synced by Drive), deliberately untracked - see HANDOFF.md.
# These went in via an over-staged commit on 2026-08-29 and were untracked on
# 2026-08-31.
tools/manim/
docs/lms.md
docs/future-topics/
docs/Gradient Descent.md

# Local environment & Quarto intermediates
.env
**/.env
slides/*/*.quarto_ipynb*
_extensions/

